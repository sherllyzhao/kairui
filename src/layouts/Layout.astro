---
import {requestData} from "../assets/js/jzt_common";
import Banner from "../components/Banner.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

let siteInfo = {
  title: '山西凯瑞工业发展有限公司',
  keywords: '山西凯瑞工业发展有限公司',
  description: '山西凯瑞工业发展有限公司',
  icon: ''
};
try {
  siteInfo = await requestData('site');
} catch (error) {
  // 加载失败时保留上面的默认值兜底
  console.error('[Layout] 获取站点信息失败:', error);
}
---

<!doctype html>
<html lang="en">
<head>
	<meta charset="utf-8"/>
	<title>{siteInfo.title || '山西凯瑞工业发展有限公司'}</title>
	<meta name="description" content={siteInfo.description || '山西凯瑞工业发展有限公司'}>
	<meta name="keywords" content={siteInfo.keywords || '山西凯瑞工业发展有限公司'}>
	<meta name="viewport" content="width=device-width"/>
	<link rel="icon" href={siteInfo.icon || './favicon.ico'}/>
	<link rel="stylesheet" href="/css/animate.min.css">
	<link rel="stylesheet" href="/css/common.css">
	<link rel="stylesheet" href="/css/header.css">
	<link rel="stylesheet" href="/css/banner.css">
	<link rel="stylesheet" href="/css/footer.css">
	<script is:inline src="/js/jquery-4.0.0.min.js"></script>
</head>
<body>
<Header/>
<slot/>
<Footer/>
<script is:inline src="/js/common.js"></script>
<script is:inline src="/js/scroll-reveal.js"></script>
<script is:inline>
  ScrollReveal.init({
    mode: 'toggle',
    selector: '.reveal-on-scroll',
    // 入/退场位移约 110px。离场加 140px 缓冲，避免页面顶部/底部反复抖动。
    visibility: {top: 0.88, bottom: 0.12},
    toggleExitOffset: 140
  });
</script>
</body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
        height: 100%;
    }
</style>
