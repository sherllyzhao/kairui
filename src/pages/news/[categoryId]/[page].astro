---
import Layout from "../../../layouts/Layout.astro";
import Banner from "../../../components/Banner.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import { requestData, timeStamp2String } from "../../../assets/js/jzt_common";
import Pagination from "../../../components/Pagination.astro";

export async function getStaticPaths({ paginate }) {
	const pageSize = 10;
	const rootCategoryId = "6a65771ba6ba0c2e856b11c8";

	const toList = (result) =>
		Array.isArray(result) ? result : result?.data ?? [];

	const categoryResult = await requestData("category", {
		sort: "sortAsc",
		category_id: rootCategoryId,
		data_type: "list",
		limit: -1,
	});

	const categories = toList(categoryResult);
	const paths = [];

	for (const category of categories) {
		const goodsResult = await requestData("content", {
			sort: "sortAsc",
			category_id: category.id,
			data_type: "list",
			limit: -1,
		});

		const goods = toList(goodsResult);
		const paginated = paginate(goods, {
			params: { categoryId: String(category.id) },
			pageSize,
		});
		paths.push(...paginated);
	}

	return paths;
}

const pageSize = 10;
const { categoryId } = Astro.params;
const { page } = Astro.props;
const newsList = page.data;

const cateResult = await requestData("category", {
	sort: "sortAsc",
	category_id: "6a65771ba6ba0c2e856b11c8",
	data_type: "list",
	limit: -1,
});

const cateList = Array.isArray(cateResult)
	? cateResult
	: cateResult?.data ?? [];

const categoryIndex = cateList.findIndex(item => String(item.id) === categoryId);
const currentCateId = categoryIndex !== -1 ? cateList[categoryIndex].id : cateList[0]?.id;

const cateListWithUrl = cateList.map(item => ({
	...item,
	url: `/news/${item.id}/1.html`
}));

const getTime = (time) => {
	return timeStamp2String(time, 'Y-m-d')
}
---

<Layout>
	<link rel="stylesheet" href="/css/breadcrumbs.css">
	<link rel="stylesheet" href="/css/news.css" />
	<link rel="stylesheet" href="/css/pagination.css" />

	<Banner id="6a5d9ba1233ff835982878ea" />
	<Breadcrumbs pageName="新闻动态" tabs={cateListWithUrl} usePageName={true} name="news-breadcrumbs" />
	<div class="news-list-wrap">
		<div class="page-container">
			{
				newsList.length ? <div class="news-list">
					{
						newsList.map((item, index) => <a href={`/newsDetails/?id=${item.id}.html?cateId=${currentCateId}`} class="news-item flex flex-column align-center reveal-on-scroll" style={{ '--reveal-delay': (index % 5) * 70 + 'ms' }} data-index={index}>
							<div class="news-img">
								<img src={item.bg_img} alt="">
							</div>
							<div class="news-desc">
								<time class="news-time">{getTime(item.create_time)}</time>
								<!--<h5 class="news-name hide-more-text" style="&#45;&#45;lines: 1">{{item.title}}</h5>
								<p class="news-intro hide-more-text" style="&#45;&#45;lines: 2">{{item.intro}}</p>-->
							</div>
						</a>)
					}

				</div> : <div class="news-empty">暂无文章</div>
			}

			<Pagination total={page.total} pageSize={pageSize} currentPage={page.currentPage} />
		</div>
	</div>

	<script define:vars={{cateListWithUrl}}>
		window.addEventListener('breadcrumb-change', (e) => {
			if(e.detail.name === "news-breadcrumbs"){
				const categoryId = cateListWithUrl[e.detail.activeIndex]?.id;
				window.location.href = `/product/${categoryId}/1`;
			}
		})
	</script>
</Layout>
