---
import type { GetStaticPaths } from "astro";
import Layout from "../../../layouts/Layout.astro";
import Banner from "../../../components/Banner.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import { requestData, timeStamp2String } from "../../../assets/js/jzt_common.ts";
import Pagination from "../../../components/Pagination.astro";

const rootCategoryId = "6a65771ba6ba0c2e856b11c8";

// 用 satisfies 而非 `: GetStaticPaths` 注解：satisfies 保留 paginate() 推断出的
// 具体 params/props 形状，Astro.params / Astro.props 才能自动收窄；
// 类型注解会把返回值擦成 GetStaticPathsResult，page 退化为 any。
//
// 注意：getStaticPaths 会被 Astro 提取到独立作用域执行，读不到 frontmatter 的
// 其它变量（import 除外），所以 pageSize / rootCategoryId 必须在函数内自带一份。
export const getStaticPaths = (async ({ paginate }) => {
	const pageSize = 10;
	const rootCategoryId = "6a65771ba6ba0c2e856b11c8";

	const categories = await requestData("category", {
		sort: "sortAsc",
		category_id: rootCategoryId,
		data_type: "list",
		limit: -1,
	});

	const paths = [];

	for (const category of categories) {
		// data_type: 'list' 经 FilterResult 条件类型收窄为 DataItem[]，无需数组兜底
		const news = await requestData("content", {
			sort: "sortAsc",
			category_id: category.id,
			data_type: "list",
			limit: -1,
		});

		paths.push(...paginate(news, {
			params: { categoryId: String(category.id) },
			pageSize,
		}));
	}

	return paths;
}) satisfies GetStaticPaths;

const pageSize = 10;
const { categoryId } = Astro.params;
const { page } = Astro.props;
const newsList = page.data;

const cateList = await requestData("category", {
	sort: "sortAsc",
	category_id: rootCategoryId,
	data_type: "list",
	limit: -1,
});

const categoryIndex = cateList.findIndex(item => String(item.id) === categoryId);
const currentCateId = categoryIndex !== -1 ? cateList[categoryIndex].id : cateList[0]?.id;

const cateListWithUrl = cateList.map(item => ({
	...item,
	url: `/news/${item.id}/1.html`
}));

// create_time 在 DataItem 中是可选字段，缺失时不渲染日期
const getTime = (time: number | string | undefined) => {
	return time === undefined ? '' : timeStamp2String(time, 'Y-m-d')
}
---

<Layout>
	<link rel="stylesheet" href="/css/breadcrumbs.css">
	<link rel="stylesheet" href="/css/news.css" />
	<link rel="stylesheet" href="/css/pagination.css" />

	<Banner id="6a5d9ba1233ff835982878ea" />
	<Breadcrumbs pageName="新闻动态" tabs={cateListWithUrl} usePageName={true} name="news-breadcrumbs" />
	<div class="news-list-wrap">
		<div class="page-container">
			{
				newsList.length ? <div class="news-list">
					{
						newsList.map((item, index) => <a href={`/newsDetails/${item.id}.html?cateId=${currentCateId}`} class="news-item flex flex-column align-center reveal-on-scroll" style={{ '--reveal-delay': (index % 5) * 70 + 'ms' }} data-index={index}>
							<div class="news-img">
								<img src={item.bg_img} alt="">
							</div>
							<div class="news-desc">
								<time class="news-time">{getTime(item.create_time)}</time>
								<h5 class="news-name hide-more-text" style="--lines: 1">{item.title}</h5>
								<p class="news-intro hide-more-text" style="--lines: 2">{item.intro}</p>
							</div>
						</a>)
					}

				</div> : <div class="news-empty">暂无文章</div>
			}

			<Pagination total={page.total} pageSize={pageSize} currentPage={page.currentPage} />
		</div>
	</div>

	<script define:vars={{cateListWithUrl}}>
		window.addEventListener('breadcrumb-change', (e) => {
			if(e.detail.name === "news-breadcrumbs"){
				const categoryId = cateListWithUrl[e.detail.activeIndex]?.id;
				window.location.href = `/news/${categoryId}/1`;
			}
		})
	</script>
</Layout>
