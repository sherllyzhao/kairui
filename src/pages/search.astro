---
import Layout from "../layouts/Layout.astro";
import Banner from "../components/Banner.astro";
import Pagination from "../components/Pagination.astro";
---

<Layout>
    <link rel="stylesheet" href="/css/search.css">
    <link rel="stylesheet" href="/css/pagination.css">

    <Banner id="6a5d9be45a35bf61660a666f">
		<!-- <div slot="search"> 具名插槽这么写-->
	    <div class="search-wrap f-h flex flex-column align-center justify-center">
		    <div class="tips">请问您要查询哪个公司</div>
		    <div class="search-box flex">
			    <input type="search" placeholder="请输入公司名称" class="show flex-1 f-h">
			    <button class="btn search-btn f-h show">查询</button>
		    </div>
	    </div>
    </Banner>

	<div class="search-result-wrap fixed flex justify-center align-center hide">
		<div class="search-result-dialog">
			<div class="dialog-header relative">
				<div class="dialog-title flex align-center justify-center">查询结果</div>
				<div class="dialog-close absolute">
					<b>×</b>
				</div>
			</div>
			<div class="dialog-body">
			</div>
		</div>
	</div>

	<script is:inline src="/js/jzt_common.js"></script>
	<script is:inline>
		(function () {
			$('.search-btn').click(function () {
				window.location.href = `/search?q=${$('.search-box input').val()}&page=1`;
			})

			const q = getUrlParam('q');
			const currentPage = getUrlParam('page');
			let total = 0;
			if(q && currentPage){
				$('.search-result-wrap').css('display', 'flex');
				requestData('content', {search_name: q, sort: 'sortAsc', page: currentPage, limit: 10, category_id: '6a65a5463f14e2005f2e6147'}, res => {
					const searchResult = res.data;
					total = res.total;
					if(!searchResult.length){
						return $('.search-result-wrap .dialog-body').html(`<div class="product-empty">暂无结果</div>`);
					}
					const listItem = searchResult.map(item => `
						<div class="result-item">
							<div class="result-name flex align-center justify-center">${item.title}</div>
						</div>
					`).join('');
					
					const totalPages = Math.ceil(total / 10);

					const visiblePages = () => {
						const lastPage = totalPages;
						if (lastPage <= 7) {
							return Array.from({length: lastPage}, (_, index) => index + 1);
						}
						if (currentPage <= 4) {
							return [1, 2, 3, 4, 5, 'ellipsis', lastPage];
						}
						if (currentPage >= lastPage - 3) {
							return [1, 'ellipsis', lastPage - 4, lastPage - 3, lastPage - 2, lastPage - 1, lastPage];
						}
						return [1, 'ellipsis', currentPage - 1, currentPage, currentPage + 1, 'ellipsis', lastPage];
					};


					const currentItem = visiblePages().map((page, index) => {
						let active = currentPage === page ? 'active' : '';
						return page === 'ellipsis' ? `<span class="pagination-ellipsis" aria-hidden="true">...</span>` :
							`<button class="pagination-button flex align-center justify-center ${active}" type="button" aria-current="${currentPage === page ? 'currentPage' : undefined}" aria-label="${'第 ' + currentPage + ' 页'}" to="${currentPage}">
								${currentPage}
							</button>`
					})

					const pagination = `					
						<nav class="pagination flex align-center justify-center" data-name="search" aria-label="分页导航">
							<button class="pagination-button pagination-prev flex align-center justify-center" type="button" disabled=${(currentPage <= 1)} aria-label="上一页" to=${(currentPage - 1)}>
								<span aria-hidden="true" style="pointer-events: none">上一页</span>
							</button>
							${currentItem.join('')}
							<button class="pagination-button pagination-next flex align-center justify-center" type="button" disabled=${(currentPage >= totalPages)} aria-label="下一页" to=${(currentPage + 1)}>
								<span aria-hidden="true" style="pointer-events: none">下一页</span>
							</button>
						</nav>
					`
					
					$('.search-result-wrap .dialog-body').html(`
						<div class="result-list flex flex-column">
							${listItem}
						</div>
						${totalPages >1 ? pagination : ''}
					`)

					$(`.pagination[data-name="search"] .pagination-button`).on('click', function (e) {
						const page = parseInt($(this).attr('to'));
						const nextPage = Math.min(Math.max(1, page), totalPages);
						if (nextPage === currentPage) return;
						window.location.href = `/search?q=${q}&page=${nextPage}`;
					})
				})
			}

			$('.dialog-close').click(function () {
				$('.search-result-wrap').css('display', 'none');
			})
		})()
	</script>
</Layout>