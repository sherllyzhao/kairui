---
import Layout from "../layouts/Layout.astro";
import Banner from "../components/Banner.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import {requestData} from "../assets/js/jzt_common";
import HomeTitle from "../components/HomeTitle.astro";
import Tabs from "../components/Tabs.astro";

const [cateListRes, brandIntroRes, advantageListRes] = await Promise.all([
  requestData('category', {sort: 'sortAsc', category_id: '6a603e041c54c90051403ac0'}),
  requestData('text', {sort: 'sortAsc', category_id: '6a5dc3bd8bd40418dc32f310'}),
  requestData('text', {sort: 'sortAsc', category_id: '6a5dc3c38717ec3ac0044d1a'})
])

const cateList = cateListRes?.data ?? [];
const pageName = cateListRes?.data?.[0]?.title ?? '';
const brandIntro = brandIntroRes?.data?.[0] ?? {};
const advantageList = advantageListRes?.data ?? [];
---

<Layout>
	<link rel="stylesheet" href="/css/about.css">
	<link rel="stylesheet" href="/css/breadcrumbs.css">

	<Banner id="6a5d9b79d276c860d422cca0"/>
	<Breadcrumbs tabs={cateList} pageName={pageName} name="about-breadcrumbs"/>
	<div id="brand" class="reveal-on-scroll">
		<div class="page-container flex justify-between">
			<div class="left flex-1">
				<HomeTitle title="品牌介绍" subtitle="brand introduction"/>
				<div class="brand-info" set:html={brandIntro?.details}></div>
			</div>
			<div class="right">
              {brandIntro?.bg_img && <img src={brandIntro?.bg_img} alt="">}
			</div>
		</div>
	</div>
	<div id="advantages" class="reveal-on-scroll">
		<div class="page-container">
			<HomeTitle title="我们的优势" subtitle="our advantages" color="white"/>
			<Tabs tabs={advantageList} name="about-tabs"/>
			<div class="advantage-content">
              {
                	advantageList.map((item, index) => (
						<div class="advantage-item" data-index={index}>
							<div class="advantage-desc" set:html={item.details}></div>
						</div>
                ))
              }
			</div>
		</div>
	</div>

	<script is:inline>
		function setAdvantageActiveIndex(index){
			$('#advantages .tab-item').eq(index).addClass('active').siblings().removeClass('active');
			$('#advantages .advantage-item').eq(index).addClass('active').siblings().removeClass('active');
		}

		(function (){
			setAdvantageActiveIndex(0);
		})()

		window.addEventListener('tab-change', (e) => {
			if(e.detail.name === 'about-tabs'){
				setAdvantageActiveIndex(e.detail.activeIndex);
			}
		})
	</script>
</Layout>