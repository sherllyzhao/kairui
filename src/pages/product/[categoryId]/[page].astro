---
import type { GetStaticPaths } from "astro";
import Layout from "../../../layouts/Layout.astro";
import Banner from "../../../components/Banner.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import { requestData } from "../../../assets/js/jzt_common.ts";
import Pagination from "../../../components/Pagination.astro";

// 用 satisfies 而非 `: GetStaticPaths` 注解：satisfies 保留 paginate() 推断出的
// 具体 params/props 形状，Astro.params / Astro.props 才能自动收窄；
// 类型注解会把返回值擦成 GetStaticPathsResult，page 退化为 any。
//
// 注意：getStaticPaths 会被 Astro 提取到独立作用域执行，读不到 frontmatter 的
// 其它变量（import 除外），所以 pageSize / rootCategoryId 必须在函数内自带一份。
export const getStaticPaths = (async ({ paginate }) => {
	const pageSize = 10;
	const rootCategoryId = "6a605df319df9b3e2e2b4af2";

	const categories = await requestData("category", {
		sort: "sortAsc",
		category_id: rootCategoryId,
		data_type: "list",
		limit: -1,
	});

	const paths = [];

	for (const category of categories) {
		// data_type: 'list' 经 FilterResult 条件类型收窄为 DataItem[]，无需数组兜底
		const goods = await requestData("goods", {
			sort: "sortAsc",
			category_id: category.id,
			data_type: "list",
			limit: -1,
		});

		paths.push(...paginate(goods, {
			params: { categoryId: String(category.id) },
			pageSize,
		}));
	}

	return paths;
}) satisfies GetStaticPaths;

const pageSize = 10;
const { categoryId } = Astro.params;
const { page } = Astro.props;
const productList = page.data;

const cateList = await requestData("category", {
	sort: "sortAsc",
	category_id: "6a605df319df9b3e2e2b4af2",
	data_type: "list",
	limit: -1,
});

const categoryIndex = cateList.findIndex(item => String(item.id) === categoryId);
const currentCateId = categoryIndex !== -1 ? cateList[categoryIndex].id : cateList[0]?.id;

const cateListWithUrl = cateList.map(item => ({
	...item,
	url: `/product/${item.id}/1.html`
}));
---


<Layout>
	<link rel="stylesheet" href="/css/breadcrumbs.css">
	<link rel="stylesheet" href="/css/product.css" />
	<link rel="stylesheet" href="/css/pagination.css" />

	<Banner id="6a5d9b8c64fdfb541468e9c2" />
	<Breadcrumbs pageName="产品展示" tabs={cateListWithUrl} usePageName={true} name="product-breadcrumbs" />
	{/* 外层容器刻意不加 reveal-on-scroll：入场位移只能有一层。
	    若外层也播 42px 位移，会带着内部所有卡片一起移动，
	    既造成 transform 双层叠加（84px），又会在动画的 750ms 内不断改变
	    卡片的 getBoundingClientRect()，让 IntersectionObserver 错峰触发，
	    表现为“闪好几下”。参照 news 列表，位移统一交给卡片自身。 */}
	<div class="product-list-wrap">
		<div class="page-container">
			<div class="product-list">
				{
					productList.length > 0 ? productList.map((item, index) => (
						<a href={`/productDetails/${item.id}.html?cateId=${currentCateId}`} class="product-item flex flex-column align-center reveal-on-scroll" data-index={index} style={{ '--reveal-delay': (index % 5) * 70 + 'ms' }}>
							<div class="product-img">
								<img src={item.bg_img} alt="">
							</div>
							<div class="product-desc">
								<div class="product-name hide-more-text" style="--lines: 1">{item.title}</div>
							</div>
						</a>
					)) : <div class="product-empty">暂无产品</div>
				}
			</div>
			<Pagination total={page.total} pageSize={pageSize} currentPage={page.currentPage} />
		</div>
	</div>

	<script define:vars={{cateListWithUrl}}>
		window.addEventListener('breadcrumb-change', (e) => {
			if(e.detail.name === "product-breadcrumbs"){
				const categoryId = cateListWithUrl[e.detail.activeIndex]?.id;
				window.location.href = `/product/${categoryId}/1`;
			}
		})
	</script>
</Layout>
