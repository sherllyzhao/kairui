---
import Layout from "../../../layouts/Layout.astro";
import Banner from "../../../components/Banner.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import { requestData } from "../../../assets/js/jzt_common";
import Pagination from "../../../components/Pagination.astro";

const pageSizeTotal = 10;

export async function getStaticPaths() {
	const pageSize = 10;
	const rootCategoryId = "6a605df319df9b3e2e2b4af2";

	const toList = (result) =>
		Array.isArray(result) ? result : result?.data ?? [];

	const categoryResult = await requestData("category", {
		sort: "sortAsc",
		category_id: rootCategoryId,
		data_type: "list",
		limit: -1,
	});

	const categories = toList(categoryResult);
	const paths = [];

	for (const category of categories) {
		const goodsResult = await requestData("goods", {
			sort: "sortAsc",
			category_id: category.id,
			data_type: "list",
			limit: -1,
		});

		const goods = toList(goodsResult);
		const lastPage = Math.max(1, Math.ceil(goods.length / pageSize));

		for (let page = 1; page <= lastPage; page++) {
			paths.push({
				params: {
					categoryId: String(category.id),
					page: String(page),
				},
			});
		}
	}

	return paths;
}

const { categoryId, page: pageParam } = Astro.params;
const currentPage = Math.max(1, Number(pageParam) || 1);

const cateResult = await requestData("category", {
	sort: "sortAsc",
	category_id: "6a605df319df9b3e2e2b4af2",
	data_type: "list",
	limit: -1,
});

const cateList = Array.isArray(cateResult)
	? cateResult
	: cateResult?.data ?? [];

const goodsResult = await requestData("goods", {
	sort: "sortAsc",
	category_id: categoryId,
	page: currentPage,
	limit: pageSizeTotal,
});

const productList = goodsResult?.data ?? [];
const total = goodsResult?.total ?? 0;
const lastPage = goodsResult?.last_page ?? 1;

function getCategoryIndexFromUrl (categories) {
	const categoryQueryKey = 'category';
	const categoryId = new URL(Astro.request.url).searchParams.get(categoryQueryKey);
	const index = categories.findIndex(item => String(item.id) === categoryId);
	return index === -1 ? 0 : index;
}

const categoryIndex = getCategoryIndexFromUrl(cateList);
const currentCateId = cateList[categoryIndex].id;
---


<Layout>
	<link rel="stylesheet" href="/css/breadcrumbs.css">
	<link rel="stylesheet" href="/css/product.css" />
	<link rel="stylesheet" href="/css/pagination.css" />

	<Banner id="6a5d9b8c64fdfb541468e9c2" />
	<Breadcrumbs pageName="产品展示" tabs={cateList} usePageName={true} />
	<div class="product-list-wrap reveal-on-scroll">
		<div class="page-container">
			<div class="product-list">
				{
					productList.length > 0 ? productList.map((item, index) => (
						<a href={`/productDetails.html?id=${item.id}&cateId=${currentCateId}`} class="product-item flex flex-column align-center reveal-on-scroll" data-index={index} :style="{ '--reveal-delay': (index % 5) * 70 + 'ms' }">
							<div class="product-img">
								<img src={item.bg_img} alt="">
							</div>
							<div class="product-desc">
								<div class="product-name hide-more-text" style="--lines: 1">{item.title}</div>
							</div>
						</a>
					)) : <div class="product-empty">暂无产品</div>
				}
			</div>
			<Pagination total={total} pageSize={pageSizeTotal} currentPage={1} />
		</div>
	</div>

	<script define:vars={{cateList}}>
      (function (){
      })()
	</script>
</Layout>
