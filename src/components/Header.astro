---
import '../assets/css/header.scss';
import {requestData} from "../assets/js/jzt_common";

let pcLogo = '';
let mobileLogo = '';
let navList = [];
const navMap = {
  '关于我们': '6a5d9b79d276c860d422cca0',
  '产品展示': '6a5d9b8c64fdfb541468e9c2',
  '新闻动态': '6a5d9ba1233ff835982878ea'
}
try {
  const site = await requestData('site');
  pcLogo = site.pc_logo;
  mobileLogo = site.phone_logo;

  const res = await requestData('nav', {sort: 'sortAsc'});
  navList = res.data || res;

  // 三个分类请求相互独立，并行获取
  const [about
	  , goodsRes, contentRes] = await Promise.all([
    requestData('category', {sort: 'sortAsc', category_id: '6a603e041c54c90051403ac0'}),
    requestData('category', {sort: 'sortAsc', category_id: '6a605df319df9b3e2e2b4af2'}),
    requestData('category', {sort: 'sortAsc', category_id: '6a65771ba6ba0c2e856b11c8'})
  ]);

  // 关于我们
  const aboutUs = about.data || [];
  if (aboutUs.length > 0) {
    const aboutUsItem = navList.find(item => item.id === navMap['关于我们']);
    if (aboutUsItem) {
      aboutUsItem["children"] = aboutUs;
    }
  }
  // 产品
  const goods = goodsRes.data || [];
  if (goods.length > 0) {
    const goodsItem = navList.find(item => item.id === navMap['产品展示']);
    if (goodsItem) {
      goodsItem["children"] = goods;
    }
  }
  // 内容
  const content = contentRes.data || [];
  if (content.length > 0) {
    const contentItem = navList.find(item => item.id === navMap['新闻动态']);
    if (contentItem) {
      contentItem["children"] = content;
    }
  }
} catch (error) {
  console.error('[Header] 获取导航数据失败:', error);
}

const isEn = Astro.url.href.includes('/en');
const toEn = isEn ? '/' : '/en';
---
<header>
	<div class="header flex align-center justify-between">
		<div class="logo flex align-center">
			<img src={pcLogo} class="pc-logo" alt="">
			<img src={mobileLogo} class="mobile-logo" alt="">
		</div>
		<button class="mobile-menu-toggle" type="button" aria-expanded="false" aria-label="切换导航菜单">
			<span></span>
			<span></span>
			<span></span>
		</button>
		<div class="nav f-h flex align-center">
			<nav class="f-h">
				<ul class="flex align-center justify-between first-nav f-h">
					{
						navList.length && navList.map(item => {
							return <li key={item.id} class="relative f-h flex align-center">
								<a href={`.${item.link}`}>{item.title}</a>
								{item.children && item.children.length > 0 && (
									<div class="second-nav">
										<ul>
											{item.children.map(child => (
												<li key={child.id}>
													<a href={`.${item.link}?category=${child.id}`}>{child.title}</a>
												</li>
											))}
										</ul>
									</div>
								)}
							</li>
						})
					}
				</ul>
			</nav>
			<a href={toEn} class="change-language-site flex align-center justify-center">
				<span>{!isEn ? 'EN' : '中文'}</span>
			</a>
		</div>
	</div>
</header>

<script is:inline>
  let isScrolled = false;
  function handleScroll() {
    isScrolled = window.scrollY > 0;
	$('header').toggleClass('scrolled', isScrolled);
  }
  window.addEventListener('scroll', handleScroll);

  let mobileMenuOpen = false;
  $('.mobile-menu-toggle').click(function () {
    mobileMenuOpen = !mobileMenuOpen;
    $(this).attr('aria-expanded', mobileMenuOpen);
	$('.nav').toggleClass('open', mobileMenuOpen);
  })
</script>