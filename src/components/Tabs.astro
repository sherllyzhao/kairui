---
const {tabs = [], name = 'tabs'} = Astro.props;
---

<link rel="stylesheet" href="./css/tabs.css">
<div class="tab flex align-center my-tabs">
  {
    tabs.map((item, index) => {
      return <div class="tab-item relative" key={item.id} data-index={index} data-name={name}>
        <span style="pointer-events: none;">{item.title}</span>
      </div>
    })
  }
</div>

<script>
  (function (){
      $('.tab-item').on('click', function (){
        const index = $(this).data('index');
        const name = $(this).data('name');
        window.dispatchEvent(new CustomEvent('tab-change', {
          detail: { activeIndex: index, name:  name}
        }));
      })
  })()
</script>