[{"category_id":"6a5dc3c38717ec3ac0044d1a","label_id":[],"sort":3,"status":1,"type":"text","details":"<p>矿山专属核心优势<\/p>","intro":"矿山专属核心优势","title":"矿山专属核心优势","column_id":"6a5dc3113d9186740d0b1c5a","site_id":"6a5d900c3b7c8a0bdb25998e","bg_img":"","create_time":"2026-07-23 17:31:55","update_time":"2026-08-13 10:54:09","editTitle":false,"readnum":0,"showTitleTip":false,"id":"6a61df8b2f0ce321d50e3087"},{"category_id":"6a5dc3c38717ec3ac0044d1a","label_id":[],"sort":2,"status":1,"type":"text","details":"<p>&mdash; 原材料：采用高纯净度进口轴承专用钢，杂质少、金相组织稳定，抗疲劳、抗磨损性能大幅提升。<\/p>\n<p>&mdash; 加工工艺：全自动化精密磨床加工，微米级尺寸公差控制，精度稳定、一致性高。<\/p>\n<p>&mdash; 密封结构：多重迷宫+接触式复合密封，有效阻隔粉尘、水汽、杂质侵入，延长润滑周期，减少维护次数。<\/p>\n<p>&mdash; 品控检测：所有产品100%经过无损探伤、振动分级、噪音检测、载荷测试，全检出厂，品质稳定可控。<\/p>","title":"核心技术优势","intro":"","column_id":"6a5dc3113d9186740d0b1c5a","site_id":"6a5d900c3b7c8a0bdb25998e","bg_img":"","create_time":"2026-07-23 17:30:43","update_time":"2026-07-23 17:31:16","editTitle":false,"readnum":0,"showTitleTip":false,"id":"6a61df43b7114f2bb6231401"},{"category_id":"6a5dc3bd8bd40418dc32f310","label_id":[],"sort":1,"status":1,"type":"text","details":"<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp;德国GRONDE格朗德，根植于德国工业核心产区，承袭德国百年精密制造基因，严格对标一线德系轴承制造标准，专注高端工业轴承的研发、生产与应用配套。品牌全程遵循德国DIN工业严苛制造体系，坚持以高精度、高稳定性、长使用寿命为核心产品理念。<\/p>\n<p>&nbsp;<\/p>\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp;GRONDE格朗德轴承全部产品采用真空电渣重熔高纯净轴承钢材，通过微米级滚道超精研磨工艺、多重密封结构优化、上万次疲劳极限测试、高低温交变测试、重载冲击可靠性测试，把德国精工严谨的制造标准落实到每一颗轴承的生产细节。专为风电、矿山、冶金、轨道交通、工程机械、工业电机、通用重工设备提供高可靠性核心运转部件，是德系高性价比精工轴承代表品牌。<\/p>","intro":"","title":"品牌介绍","bg_img":"https:\/\/oss.lcweb01.cn\/jzt\/6a5d900c3b7c8a0bdb25998e\/image\/20260723\/9bd4ec4392092ac5860e7d30861019d4.png","column_id":"6a5dc3113d9186740d0b1c5a","site_id":"6a5d900c3b7c8a0bdb25998e","create_time":"2026-07-23 17:29:48","update_time":"2026-07-23 17:47:04","editTitle":false,"readnum":0,"showTitleTip":false,"id":"6a61df0c8d086c244a455885"}]